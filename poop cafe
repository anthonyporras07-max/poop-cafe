<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Grass Hopper's Devil Play Den</title>

<style>
body{
    margin:0;
    padding:20px;
    overflow-x:hidden;
    font-family:Trebuchet MS,sans-serif;
    color:white;

    background:
    linear-gradient(
        rgba(0,0,0,.75),
        rgba(0,0,0,.92)
    ),
    url("haunted-forest.jpg");

    background-size:cover;
    background-position:center;
    background-attachment:fixed;
}

#loadingScreen{
    position:fixed;
    inset:0;
    background:black;
    z-index:9999;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    gap:20px;
    transition:opacity 2s;
}

.loading-eyes{
    display:flex;
    gap:150px;
}

.loading-eye{
    width:120px;
    height:170px;
    border-radius:50%;
    background:
      radial-gradient(circle,
      #b5ff7d,
      #58ff00,
      #0f3500);
    position:relative;

    box-shadow:
      0 0 30px #58ff00,
      0 0 60px #58ff00,
      0 0 120px #58ff00;

    animation:blink 6s infinite;
}

.loading-pupil{
    position:absolute;
    width:14px;
    height:120px;
    background:black;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    border-radius:30px;
}

.loading-text{
    color:#58ff00;
    text-align:center;
    font-size:22px;
}

.cat-eyes{
    display:flex;
    justify-content:center;
    gap:120px;
    margin-top:20px;
}

.eye{
    width:90px;
    height:130px;
    border-radius:50%;

    background:
    radial-gradient(circle,
    #b5ff7d,
    #58ff00,
    #123900);

    position:relative;

    box-shadow:
      0 0 20px #58ff00,
      0 0 40px #58ff00,
      0 0 80px #58ff00;

    animation:blink 8s infinite;
}

.pupil{
    position:absolute;
    width:11px;
    height:100px;
    background:black;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    border-radius:30px;
}

@keyframes blink{
    0%,48%,52%,100%{
        transform:scaleY(1);
    }
    50%{
        transform:scaleY(.05);
    }
}

h1{
    text-align:center;
    color:orange;
    font-size:3rem;

    text-shadow:
    0 0 15px orange,
    0 0 30px orange;
}

.subtitle{
    text-align:center;
    color:#64ff64;
    margin-bottom:25px;
}

.musicBtn{
    display:block;
    margin:auto;
}

.grasshopper{
    margin:25px auto;
    max-width:900px;
    background:rgba(0,0,0,.6);
    border:2px solid #58ff00;
    border-radius:15px;
    padding:20px;
}

.warning{
    text-align:center;
    color:#58ff00;
    margin:20px;
    font-size:20px;
}

#cart{
    background:rgba(0,0,0,.65);
    border:2px solid #58ff00;
    border-radius:15px;
    padding:20px;
    max-width:900px;
    margin:20px auto;
}

input{
    width:100%;
    padding:12px;
    margin-bottom:15px;
    border-radius:10px;
    border:none;
}

.menu{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(250px,1fr));
    gap:15px;
}

.card{
    background:rgba(0,0,0,.7);
    border:2px solid orange;
    padding:15px;
    border-radius:15px;
}

button{
    background:orange;
    color:black;
    border:none;
    border-radius:10px;
    padding:10px 15px;
    font-weight:bold;
    cursor:pointer;
}

button:hover{
    background:#ffd280;
}

.bat,.ghost,.pumpkin{
    position:fixed;
    pointer-events:none;
}

.bat{
    font-size:40px;
    animation:fly linear infinite;
}

.bat1{top:10%;animation-duration:15s;}
.bat2{top:25%;animation-duration:11s;}
.bat3{top:40%;animation-duration:18s;}

@keyframes fly{
    from{transform:translateX(-200px);}
    to{transform:translateX(120vw);}
}

.ghost{
    font-size:50px;
    opacity:.75;
}

.ghost1{
    left:10px;
    bottom:120px;
    animation:floaty 6s infinite;
}

.ghost2{
    right:10px;
    bottom:180px;
    animation:floaty 8s infinite;
}

@keyframes floaty{
    50%{transform:translateY(-30px);}
}

.pumpkin{
    font-size:35px;
}

.pumpkin1{
    left:15px;
    bottom:10px;
}

.pumpkin2{
    right:15px;
    bottom:15px;
}

.pumpkin3{
    left:50%;
    bottom:5px;
}

.fog{
    position:fixed;
    top:0;
    left:-100%;
    width:300%;
    height:100%;

    background:
    radial-gradient(
        circle,
        rgba(255,255,255,.08),
        transparent
    );

    animation:fogMove 60s linear infinite;
}

.fog2{
    animation-duration:90s;
}

@keyframes fogMove{
    from{transform:translateX(0);}
    to{transform:translateX(-50%);}
}

.particle{
    position:fixed;
    top:-20px;
    animation:fall linear infinite;
}

@keyframes fall{
    to{
        transform:translateY(120vh);
    }
}

.submission-box{
    margin-top:20px;
    text-align:center;
    background:rgba(0,0,0,.8);
    padding:20px;
    border-radius:15px;
    border:2px solid #58ff00;
}

.submit-link{
    text-decoration:none;
}

.submit-link button{
    width:240px;
    margin:5px;
}
</style>
</head>

<body>

<div id="loadingScreen">
    <div class="loading-eyes">
        <div class="loading-eye"><div class="loading-pupil"></div></div>
        <div class="loading-eye"><div class="loading-pupil"></div></div>
    </div>
    <div class="loading-text">🐈‍⬛ Grasshopper is watching...</div>
    <div id="loadingMessage" class="loading-text"></div>
</div>

<div class="fog"></div>
<div class="fog fog2"></div>

<div class="bat bat1">🦇</div>
<div class="bat bat2">🦇</div>
<div class="bat bat3">🦇</div>

<div class="ghost ghost1">👻</div>
<div class="ghost ghost2">👻</div>

<div class="pumpkin pumpkin1">🎃</div>
<div class="pumpkin pumpkin2">🎃</div>
<div class="pumpkin pumpkin3">🎃</div>

<div class="cat-eyes">
    <div class="eye"><div class="pupil"></div></div>
    <div class="eye"><div class="pupil"></div></div>
</div>

<h1>🎃 Welcome to Grass Hopper's Devil Play Den 🎃</h1>

<div class="subtitle">
    Guardian of the Midnight Snacks<br>
    Enter If You Dare...
</div>

<button class="musicBtn" id="musicBtn">
    🎵 Start Spooky Music
</button>

<audio id="themeMusic" loop>
    <source src="spooky.mp3" type="audio/mpeg">
</audio>

<div id="warning" class="warning"></div>

<div class="grasshopper">
    <h2>🐈‍⬛ Meet Grasshopper</h2>
    <p>Grasshopper is a mysterious black cat with glowing green eyes who rules over the Devil Play Den.</p>
    <p>Every cookie, brownie, chip and midnight snack must receive her blessing.</p>
</div>

<div id="cart">
    <h2>Your Offering</h2>
    <input id="guestName" placeholder="Enter Your Name">
    <div id="cartItems"></div>
    <p>Items: <span id="total">0</span></p>
    <button onclick="checkout()">Offer Tribute</button>
    <div id="submissionOptions"></div>
</div>

<div class="menu" id="menu"></div>

<script>
const inventory = [
    {name:"🐈‍⬛ Grasshopper's Special",stock:4},
    {name:"🎃 Pumpkin Cookies",stock:12},
    {name:"👻 Ghost Chips",stock:8},
    {name:"🦇 Bat Wing Brownies",stock:6},
    {name:"🍬 Monster Mix",stock:15},
    {name:"🕸️ Spider Web Cupcakes",stock:9},
    {name:"🧙 Witch's Brew Cola",stock:10}
];

let cart = [];

function renderMenu(){
    const menu = document.getElementById("menu");
    menu.innerHTML = "";

    inventory.forEach((item, index) => {
        if(item.stock > 0){
            let stockDisplay = item.stock <= 2
                ? `<span style="color:red;font-size:20px;">🚨 ${item.stock}</span>`
                : item.stock;

            menu.innerHTML += `
            <div class="card">
                <h3>${item.name}</h3>
                <p>Remaining: ${stockDisplay}</p>
                <button onclick="addToCart(${index})">
                    Add To Offering
                </button>
            </div>
            `;
        }
    });
}

function checkLowStock(item){
    if(item.stock === 2){
        const textBody = encodeURIComponent(
`⚠️ LOW STOCK ALERT

${item.name}

Only 2 remaining in
Grass Hopper's Devil Play Den.

🐈‍⬛ Grasshopper requests restocking.`
        );

        document.getElementById("submissionOptions").innerHTML += `
        <div class="submission-box">
            <h3>⚠️ Low Stock Warning</h3>
            <a href="sms:7865682732?body=${textBody}" class="submit-link">
                <button>📱 Notify Tony</button>
            </a>
        </div>
        `;
    }

    if(item.stock === 0){
        const textBody = encodeURIComponent(
`🚨 OUT OF STOCK

${item.name}

Inventory has been depleted.

🐈‍⬛ Grasshopper demands immediate replenishment.`
        );

        document.getElementById("submissionOptions").innerHTML += `
        <div class="submission-box">
            <h3>🚨 Out of Stock</h3>
            <a href="sms:7865682732?body=${textBody}" class="submit-link">
                <button>📱 Notify Tony</button>
            </a>
        </div>
        `;
    }
}

function addToCart(index){
    inventory[index].stock--;
    
    checkLowStock(inventory[index]);

    const found = cart.find(x => x.name === inventory[index].name);

    if(found){
        found.qty++;
    } else {
        cart.push({
            name: inventory[index].name,
            qty: 1
        });
    }

    renderCart();
    renderMenu();
}

function renderCart(){
    let total = 0;
    const cartDiv = document.getElementById("cartItems");
    cartDiv.innerHTML = "";

    cart.forEach(item => {
        total += item.qty;
        cartDiv.innerHTML += `<p>${item.name} x ${item.qty}</p>`;
    });

    document.getElementById("total").innerText = total;
}

function checkout(){
    if(cart.length === 0){
        alert("👻 Your offering basket is empty.");
        return;
    }

    const guestName = document.getElementById("guestName").value || "Unknown Visitor";

    let orderText = `🐈‍⬛ ORDER\n\nGuest:\n${guestName}\n\n`;

    cart.forEach(item => {
        orderText += `${item.name} x ${item.qty}\n`;
    });

    orderText += "\n🐾 Approved by Grasshopper";

    const encoded = encodeURIComponent(orderText);
    const emailLink = `mailto:anthonyjamescorea@gmail.com?subject=Grass Hopper Order&body=${encoded}`;
    const smsLink = `sms:7865682732?body=${encoded}`;

    document.getElementById("submissionOptions").innerHTML = `
    <div class="submission-box">
        <h2>🐈‍⬛ Grasshopper Approves</h2>
        <p>Choose how to send your offering.</p>
        <a class="submit-link" href="${emailLink}">
            <button>📧 Email Order</button>
        </a>
        <br>
        <a class="submit-link" href="${smsLink}">
            <button>📱 Text Order</button>
        </a>
    </div>
    `;
}

renderMenu();

document.getElementById("musicBtn").onclick = () => {
    document.getElementById("themeMusic").play();
};

const messages = [
    "Consulting snack spirits...",
    "Polishing the haunted snack vault...",
    "Summoning pumpkin guardians...",
    "Training the bats...",
    "Checking tribute permissions...",
    "Grasshopper is judging visitors..."
];

document.getElementById("loadingMessage").innerText = 
    messages[Math.floor(Math.random() * messages.length)];

window.addEventListener("load", () => {
    setTimeout(() => {
        const loader = document.getElementById("loadingScreen");
        loader.style.opacity = "0";
        setTimeout(() => {
            loader.remove();
        }, 2000);
    }, 3500);
});

const warnings = [
    "🐾 Grasshopper sees all.",
    "🎃 The pumpkins are watching.",
    "👻 A ghost stole the last cookie.",
    "🦇 Beware the midnight bats.",
    "🌙 Midnight snackers welcome."
];

document.getElementById("warning").innerText = 
    warnings[Math.floor(Math.random() * warnings.length)];

for(let i = 0; i < 60; i++){
    const p = document.createElement("div");
    p.className = "particle";
    p.innerHTML = Math.random() > .5 ? "🍂" : "🕸️";
    p.style.left = Math.random() * 100 + "vw";
    p.style.fontSize = (10 + Math.random() * 25) + "px";
    p.style.animationDuration = (5 + Math.random() * 15) + "s";
    document.body.appendChild(p);
}
</script>

</body>
</html>
